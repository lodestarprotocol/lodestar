/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://coston2-api.flare.network https://rpc.ankr.com https://coston2.enosys.global https://coston2-explorer.flare.network wss:; frame-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Anything not matched below inherits the revalidate-always default above. Without it, a file with
# no rule here got a 7-day edge cache: after the switchover doc was deleted from the site it kept
# being served on the custom domain for days from cache, while the pages.dev alias was already
# correct. Content-addressed assets opt back into long caching explicitly.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
