/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://coston2-api.flare.network https://rpc.ankr.com https://coston2.enosys.global https://coston2-explorer.flare.network wss:; frame-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Do NOT add a Cache-Control to the /* block. Pages APPENDS matching rules instead of overriding them,
# so a default there produced "max-age=0, must-revalidate, public, max-age=31536000, immutable" on
# /assets/*, a contradictory header whose first max-age wins and which therefore silently ends the
# year-long asset caching. Measured on the alias 2026-08-01, then reverted.
#
# The consequence is that a file with no rule here gets a long edge cache. That is how the switchover
# doc kept being served on the custom domain after the commit that deleted it, while the pages.dev
# alias was already correct: deleting a file does not evict what the edge already holds. Give any new
# non-asset file its own rule, and purge the cache after removing anything.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
